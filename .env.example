# Supabase (server and browser). The publishable key is safe in the browser; the service role
# key is server-only and must never be exposed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway: every model call goes through it, with zero data retention enforced.
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENFORCE_ZDR=true

# Protects the scheduled endpoints.
CRON_SECRET=

# Optional company registers.
DATAFORDELER_API_KEY=
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=

# Brain, the team's knowledge layer.
BRAIN_ENABLED=true
