    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs src/components src/routes src/lib --server --max 0",
    "export:fund": "node scripts/export-fund.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "registries:check": "node --import ./scripts/lib/register-alias.mjs scripts/registries-check.ts",
    "seed:demo": "node --import ./scripts/lib/register-alias.mjs scripts/selfhost/seed-demo.ts",
    "test:theses-db": "node scripts/test-theses-db.mjs",
    "test:config-restore-db": "node scripts/test-config-restore-db.mjs",
    "test:setup-per-stage-db": "node scripts/test-setup-per-stage-db.mjs",
    "test:setup-per-stage-server-db": "node scripts/test-setup-per-stage-server-db.mjs",
    "test:thesis-functions-db": "node scripts/test-thesis-functions-db.mjs",
    "test:memo-db": "node scripts/test-memo-db.mjs"
