    "format": "prettier --write .",
    "test": "node --test src/lib/ai/*.test.ts src/lib/analysis/*.test.ts src/lib/analysis/registries/*.test.ts src/lib/funds/*.test.ts src/lib/memo/*.test.ts src/lib/domain/*.test.ts src/lib/auth/*.test.ts src/lib/cases/*.test.ts src/lib/brain/*.test.ts src/lib/brain/*/*.test.ts src/lib/display/*.test.ts src/lib/errors/*.test.ts src/lib/ui/*.test.ts src/lib/charts/*.test.ts src/lib/overview/*.test.ts src/lib/i18n/*.test.ts src/lib/health-cache.test.ts src/lib/health-runs.test.ts src/lib/security/*.test.ts src/lib/internal/*.test.ts scripts/lib/export-fund.test.ts scripts/lib/db-tls.test.ts scripts/lib/migration-log.test.ts scripts/lib/registries-check.test.ts scripts/lib/analysis-reconcile.test.ts scripts/lib/audit-exceptions.test.mjs scripts/selfhost/lib/*.test.ts src/lib/outbound-user-agent.test.ts",
